\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{gaokao-physics}[2026/08/05 v1.0 高考物理真题排版]

% 非矢量例外图（保留原照片/扫描件）：\gkphoto{width}{path}
% 输出带图注的居中插图，图注说明该图为原图保留。
\newcommand{\gkphoto}[3][0.8\textwidth]{%
  \begin{center}
    \includegraphics[width=#1]{#2}\\
    {\small\color{gray}（#3）}
  \end{center}}

\endinput
